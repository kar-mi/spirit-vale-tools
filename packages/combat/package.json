      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@kar-mi/spirit-vale-tools-capture": "^2.3.0",
    "@kar-mi/spirit-vale-tools-logging": "^0.9.0",
    "@kar-mi/spirit-vale-tools-metrics": "^0.2.0",
    "@kar-mi/spirit-vale-tools-skills": "^0.2.1",
    "@kar-mi/spirit-vale-tools-sqlite": "^0.2.1",
    "@kar-mi/spirit-vale-tools-statuses": "^0.2.3"
  }
}
